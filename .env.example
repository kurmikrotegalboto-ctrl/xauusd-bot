# XAUUSD Predictor Bot — Environment Variables

# ===== REQUIRED for persistence (Vercel + Upstash) =====
# Redis URL from Upstash (https://upstash.com — free 10k commands/day)
# Format: rediss://default:PASSWORD@HOST.upstash.io:PORT
# Note: must be "rediss://" (with 2 s) for TLS
REDIS_URL=

# ===== Optional: Real gold prices =====
# TwelveData API key (free tier: 8 calls/min, 800/day)
# Get free key at: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# ===== Auto-set by Vercel =====
# NODE_ENV=production (auto)
# PORT (auto)
