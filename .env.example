# XAUUSD Bot — Environment Variables
# Copy this file to .env.local for local development
# For Railway: set these in the dashboard under "Variables"

# TwelveData API key for real gold prices
# Get free key at: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=your_api_key_here

# Optional: AlphaVantage fallback
ALPHAVANTAGE_API_KEY=

# Optional: Polygon.io fallback
POLYGON_API_KEY=

# Optional: GoldAPI.io fallback
GOLDAPI_API_KEY=

# Database (Prisma) — uses SQLite locally, Railway provides PostgreSQL URL
DATABASE_URL=file:./db/custom.db

# Server port (Railway sets PORT automatically, this is for local)
PORT=3000

# Node env
NODE_ENV=production
