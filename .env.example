# XAUUSD Bot — Environment Variables
# Copy this file to .env.local for local development
# For Railway: set these in the dashboard under "Variables"

# ===== REQUIRED for persistence =====
# Redis URL — get this from Railway (Add → Database → Redis)
# Format: rediss://default:PASSWORD@HOST:PORT  (rediss:// = TLS)
# Without this, bot runs in-memory only (state lost on restart)
REDIS_URL=

# ===== Optional: Real gold prices =====
# TwelveData API key (free tier: 8 calls/min, 800/day)
# Get free key at: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# Alternative providers (fallback)
ALPHAVANTAGE_API_KEY=
POLYGON_API_KEY=
GOLDAPI_API_KEY=

# ===== Auto-set by Railway =====
# PORT=3000
# NODE_ENV=production

# ===== Local dev only =====
# DATABASE_URL=file:./db/custom.db
